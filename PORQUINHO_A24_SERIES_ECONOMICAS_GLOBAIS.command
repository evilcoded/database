#!/bin/bash
# macOS / Bash 3.2. Source patch only; no services or financial operations.
set -euo pipefail
umask 077
ROOT="${PORQUINHO_ROOT:-$HOME/Desktop/Bridge_Companion/porquinho_v33_web_foundation-2}"
PYTHON_BIN="python3"
if [ -x "$ROOT/.venv/bin/python" ]; then PYTHON_BIN="$ROOT/.venv/bin/python"; fi
if ! command -v "$PYTHON_BIN" >/dev/null 2>&1; then
 printf 'FAIL_CLOSED: Python 3.10+ não encontrado; nenhum arquivo alterado.\n'; exit 1
fi
"$PYTHON_BIN" -I -B - "$ROOT" <<'A24_PYTHON'
import sys
if sys.version_info < (3,10):
 raise SystemExit('FAIL_CLOSED: Python 3.10+ necessário; nenhum arquivo alterado.')
from pathlib import Path
import base64,hashlib,io,json,os,shutil,stat,subprocess,tempfile,zipfile
from datetime import datetime
PAYLOAD = ""
EXPECTED_PAYLOAD_SHA256 = "dc6613ae9bcdb093fed849bef445d33f061e903fdea83256827ed8a6060ee639"
raw=base64.b64decode(PAYLOAD,validate=True)
if hashlib.sha256(raw).hexdigest()!=EXPECTED_PAYLOAD_SHA256:
 raise SystemExit('FAIL_CLOSED: integridade do pacote inválida.')
root=Path(sys.argv[1]).expanduser().resolve(strict=True)
if not (root/'universal_portfolio').is_dir():
 raise SystemExit('FAIL_CLOSED: diretório ativo do Porquinho não encontrado.')

def digest_file(path):
 return hashlib.sha256(path.read_bytes()).hexdigest() if path.is_file() else None

def target(rel):
 p=root/rel
 if p.is_symlink() or any(a.is_symlink() for a in p.parents if a!=root.parent):
  raise RuntimeError('FAIL_CLOSED: symlink no caminho '+rel)
 if not p.resolve().is_relative_to(root):
  raise RuntimeError('FAIL_CLOSED: caminho fora do projeto')
 if p.exists() and not p.is_file():
  raise RuntimeError('FAIL_CLOSED: alvo não é arquivo '+rel)
 return p

INSPECTION_CODE="import sys,os,json\nfrom pathlib import Path\nroot=Path(sys.argv[1]).resolve(strict=True);sys.path.insert(0,str(root))\ndef guard(event,args):\n if event=='open':\n  mode,flags=args[1:3]\n  if (isinstance(mode,str) and any(c in mode for c in 'wax+')) or (isinstance(flags,int) and flags&(os.O_WRONLY|os.O_RDWR|os.O_CREAT|os.O_TRUNC|os.O_APPEND)):raise RuntimeError('READ_ONLY_WRITE_REFUSED')\n if event in {'os.remove','os.rename','os.mkdir','os.rmdir','os.chmod','os.truncate','os.link','os.symlink','subprocess.Popen','os.system','socket.connect','socket.bind'}:raise RuntimeError('READ_ONLY_SIDE_EFFECT_REFUSED')\nsys.addaudithook(guard)\ntry:\n from universal_portfolio.monitor_consolidation_a24 import inspect\n data=inspect(root)\n print(json.dumps({'validation':'A24_POSITION_CONSOLIDATION_READ_ONLY','status':data['status'],'monitor':data['monitor'],'brain':data['brain'],\n  'research_economic_series':data.get('research_economic_series'),'diagnostic_revision':data.get('diagnostic_revision'),'research_capture':data['research_capture'],'position_record_count':data.get('position_record_count'),'excluded_zero_position_count':data.get('excluded_zero_position_count'),'reviewed_compatibility_position_count':sum(r.get('research_identity_status')=='EXPLICIT_REVIEWED_COMPATIBILITY' for r in data['positions']),'position_research_counts':data['position_research_counts'],'canonical':data['canonical'],'issues':data['issues'],\n  'runtime_activation_proven':False,'history_write_performed':False,'financial_mutation':False},indent=2))\nexcept Exception as exc:print(json.dumps({'validation':'A24_POSITION_CONSOLIDATION_READ_ONLY','status':'INSPECTION_NOT_COMPLETED','error_type':type(exc).__name__,'history_write_performed':False,'financial_mutation':False},indent=2))\n"
ACTIVATION_PAYLOAD=''
ACTIVATION_SHA='3085849cd69655ad8466c23cebbf2172037572a8829aaeabc11571a5ea9f29d9'
def finish():
 print('INSPECTING_POSITION_CONSOLIDATION_READ_ONLY',flush=True)
 subprocess.run([sys.executable,'-I','-B','-c',INSPECTION_CODE,str(root)],cwd=root,check=True,timeout=120)
 activation_raw=base64.b64decode(ACTIVATION_PAYLOAD)
 if hashlib.sha256(activation_raw).hexdigest()!=ACTIVATION_SHA:raise RuntimeError('ACTIVATOR_INTEGRITY_FAILED')
 downloads=Path(os.environ.get('PORQUINHO_ACTIVATOR_DIRECTORY',str(Path.home()/'Downloads'))).expanduser();downloads.mkdir(exist_ok=True)
 if downloads.resolve().is_relative_to(root):raise RuntimeError('ACTIVATOR_OUTPUT_MUST_BE_OUTSIDE_PROJECT')
 activation_path=downloads/'PORQUINHO_A24_ATIVAR_CONSOLIDACAO_V9.command'
 if activation_path.exists():
  if activation_path.is_symlink() or activation_path.read_bytes()!=activation_raw:raise RuntimeError('EXISTING_ACTIVATOR_DIFFERS_PRESERVED')
 else:
  with activation_path.open('xb') as stream:stream.write(activation_raw)
  activation_path.chmod(0o700)
 print('ATIVADOR_PARA_REPETIR='+str(activation_path),flush=True)
 if os.environ.get('PORQUINHO_SKIP_ACTIVATION')=='1':print('ACTIVATION_DEFERRED_BY_EXPLICIT_ENVIRONMENT_SETTING')
 else:
  activated=subprocess.run(['/bin/bash',str(activation_path)],cwd=root,check=False)
  if activated.returncode:print('PATCH_INSTALLED; ACTIVATION_PENDING; repita somente o ativador quando o ciclo terminar.')

with zipfile.ZipFile(io.BytesIO(raw)) as package:
 metadata=json.loads(package.read('PATCH_MANIFEST.json'))
 entries=metadata['files']
 for rel in entries:target(rel)
 for rel,expected in metadata['test_baselines'].items():
  if digest_file(target(rel))!=expected:
   raise SystemExit('FAIL_CLOSED: teste existente diverge do pacote coletado: '+rel+'; nenhum arquivo alterado.')
 current={rel:digest_file(target(rel)) for rel in entries}
 already=all(current[rel]==spec['after'] for rel,spec in entries.items())
 if not already:
  for rel,spec in entries.items():
   if current[rel]!=spec['before']:
    raise SystemExit('FAIL_CLOSED: arquivo diverge do estado verificado pelo preflight: '+rel+'; nenhum arquivo alterado.')
 files={rel:package.read(rel) for rel in entries}
 for rel,content in files.items():
  if hashlib.sha256(content).hexdigest()!=entries[rel]['after']:
   raise SystemExit('FAIL_CLOSED: hash interno inválido: '+rel)
 with tempfile.TemporaryDirectory(prefix='porquinho_a24_validation_') as tmp:
  stage=Path(tmp)
  # Copy sources only. Do not copy data/results/models/history or start the app.
  for p in [*(root/'universal_portfolio').rglob('*.py'), *(root/'brain').rglob('*.py')]:
   if p.is_symlink() or any(a.is_symlink() for a in p.parents if a!=root.parent):
    raise SystemExit('FAIL_CLOSED: symlink em fontes de dependência.')
   rel=p.relative_to(root);dst=stage/rel;dst.parent.mkdir(parents=True,exist_ok=True)
   shutil.copy2(p,dst)
  for rel in metadata['test_baselines']:
   dst=stage/rel;dst.parent.mkdir(parents=True,exist_ok=True);shutil.copy2(target(rel),dst)
  for rel,content in files.items():
   dst=stage/rel;dst.parent.mkdir(parents=True,exist_ok=True);dst.write_bytes(content)
  (stage/'run_regressions.py').write_bytes(package.read('run_regressions.py'))
  print('VALIDATING_IN_TEMPORARY_SOURCE_COPY',flush=True)
  subprocess.run([sys.executable,'-I','-B',str(stage/'run_regressions.py')],cwd=stage,check=True)
 if already:
  print('ALREADY_APPLIED: hashes A24 e regressões confirmados; código preservado.')
  finish()
  raise SystemExit(0)
 # Recheck after staging to avoid overwriting changes made during validation.
 for rel in entries:
  if digest_file(target(rel))!=current[rel]:
   raise SystemExit('FAIL_CLOSED: arquivo mudou durante a validação: '+rel)
 backup=root/('.porquinho_a24_evidence_series_backup_'+datetime.now().strftime('%Y%m%d_%H%M%S_%f'))
 backup.mkdir(mode=0o700)
 for rel in entries:
  p=target(rel)
  if p.exists():
   dst=backup/rel;dst.parent.mkdir(parents=True,exist_ok=True);shutil.copy2(p,dst)
   if digest_file(dst)!=current[rel]:
    raise SystemExit('FAIL_CLOSED: backup divergente; código não alterado.')
 (backup/'PATCH_MANIFEST.json').write_text(json.dumps(metadata,indent=2))
 applied=[]
 def replace_bytes(path,content,mode):
  fd,name=tempfile.mkstemp(prefix='.a24_',dir=path.parent)
  try:
   with os.fdopen(fd,'wb') as h:
    h.write(content);h.flush();os.fsync(h.fileno())
   os.chmod(name,mode);os.replace(name,path)
  finally:
   if os.path.exists(name):os.unlink(name)
 try:
  for rel,content in files.items():
   p=target(rel)
   if digest_file(p)!=current[rel]:raise RuntimeError('Arquivo mudou durante aplicação: '+rel)
   mode=stat.S_IMODE(p.stat().st_mode) if p.exists() else 0o600
   replace_bytes(p,content,mode);applied.append(rel)
  for rel,spec in entries.items():
   if digest_file(target(rel))!=spec['after']:raise RuntimeError('Pós-check divergente: '+rel)
 except BaseException:
  for rel in reversed(applied):
   p=target(rel)
   if digest_file(p)!=entries[rel]['after']:
    print('ROLLBACK_REQUIRES_REVIEW: arquivo mudou externamente: '+rel,flush=True);continue
   old=backup/rel
   if old.is_file():replace_bytes(p,old.read_bytes(),stat.S_IMODE(old.stat().st_mode))
   else:p.unlink()
  print('APPLY_FAILED: rollback tentado; backups preservados em '+str(backup),flush=True)
  raise
 (backup/'APPLIED_OK.txt').write_text('A24 prospective capture repair applied; 490 offline Python tests and 22 UI checks passed in staging.\n')
 print('PATCH_APPLIED_A24_RESEARCH_ECONOMIC_SERIES')
 print('BACKUP='+str(backup))
 print('REGRESSION_OK: 490 testes Python; 22 verificações JavaScript; fixtures sintéticas.')
 print('CANONICAL_PROMOTION=BLOCKED_UNTIL_VERIFIED_PRODUCER')
 print('PATCH_FINANCIAL_OPERATIONS=NONE; GUARDED_ACTIVATION_FOLLOWS')
 print('O instalador preservou dados, modelos, memória e histórico existentes.')
 print('Journal global conectado à leitura econômica de pesquisa; séries separadas por identidade, provedor, moeda e amostragem.')
 print('Retornos observados exigem 31 registros para uma janela de 30 observações; não são retorno esperado nem maturação canônica de 30 dias.')
 finish()
A24_PYTHON
