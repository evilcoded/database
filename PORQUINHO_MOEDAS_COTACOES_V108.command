#!/bin/bash
set -euo pipefail
umask 077
"$HOME/anaconda3/bin/python" -I -B - <<'PYTHON'
from pathlib import Path
import base64,hashlib,datetime,shutil,os,tempfile
ROOT=Path('/Applications/Bridge_Companion/porquinho_v33_web_foundation-2')
FILES={'porquinho.py': '', 'static/balance_accounts_v41.js': '', 'static/experience_panels_v37.js': '', 'universal_portfolio/cockpit_intraday_a24.py': '', 'universal_portfolio/experience_panels_a24.py': '', 'universal_portfolio/live_financial_projection.py': '', 'universal_portfolio/monitor_consolidation_a24.py': '', 'universal_portfolio/research_quote_acquisition_a24.py': '', 'universal_portfolio/runtime_read_shadow.py': '', 'universal_portfolio/universal_cockpit_a24.py': ''}
BASELINES={'porquinho.py': ('b620de95142b9303236d0afdc8d56093baa690712905e12fb1c94e5a4d3fc989',), 'static/balance_accounts_v41.js': ('c8e0d3345b7dc68e34ee4f2de0b0a0167a84f3b36ab3e806073d572775d7295f',), 'static/experience_panels_v37.js': ('c223113820f8ef4c4dfcbc41435321526de6ebde458e0d5a57d66da87938861a',), 'universal_portfolio/cockpit_intraday_a24.py': ('441183c7b3516fa6aaf5132468d808042f6a8720f6c42d2d24aa302c93ccfebe',), 'universal_portfolio/experience_panels_a24.py': ('082576e59c0951dfb09648b5db175d7cb8aad9ca41d01982b4c88d439399102f',), 'universal_portfolio/live_financial_projection.py': ('7b451570b8d2190ef41fa186831608768127d31c1308119b13f278ec459ee387',), 'universal_portfolio/monitor_consolidation_a24.py': ('c5295e73044d3938edf0bc0c027c551c433d1971e4417e11a8f36affad49e5ef',), 'universal_portfolio/research_quote_acquisition_a24.py': ('f742e692cdbfec9f2b5c1f4471eb47573692aec344c2d07619c4a61b73af5214',), 'universal_portfolio/runtime_read_shadow.py': ('207087d1aa29195178f4df394b65826ba4dba9752270268201041de69f2147bd',), 'universal_portfolio/universal_cockpit_a24.py': ('70f3a3167a93dba6de6bb4f5f0bd84bc2f6db216728e1242d0777ea6383d7bd1',)}
assert (ROOT/'webapp/server.py').is_file(), 'PROJETO_NAO_ENCONTRADO'
assert not ROOT.is_symlink(), 'SYMLINK_RECUSADO'
prepared=[]
for name,encoded in FILES.items():
 p=ROOT/name
 assert not any(a.is_symlink() for a in [p,*p.parents]), 'SYMLINK_RECUSADO'
 assert all(not a.exists() or a.is_dir() for a in p.parents), 'PASTA_INVALIDA: '+name
 assert p.is_file() or not BASELINES[name], 'BASE_AUSENTE: '+name
 body=base64.b64decode(encoded,validate=True)
 if p.is_file() and p.read_bytes()==body: continue
 if p.exists():
  assert p.is_file(), 'DESTINO_INVALIDO: '+name
  assert hashlib.sha256(p.read_bytes()).hexdigest() in BASELINES[name], 'BASE_DIVERGENTE_PRESERVADA: '+name+' SHA256='+hashlib.sha256(p.read_bytes()).hexdigest()
 if name.endswith('.py'):compile(body,str(p),'exec')
 prepared.append((name,p,body))
backup=ROOT/('.a24_currency_valuation_v108_'+datetime.datetime.now().strftime('%Y%m%d_%H%M%S_%f'))
if prepared:
 backup.mkdir(mode=0o700)
 for name,p,body in prepared:
  if p.exists():
   dest=backup/name;dest.parent.mkdir(parents=True,exist_ok=True);shutil.copy2(p,dest)
 for name,p,body in prepared:
  p.parent.mkdir(parents=True,exist_ok=True)
  fd,tmp=tempfile.mkstemp(prefix='.recovery-',dir=p.parent)
  try:
   with os.fdopen(fd,'wb') as f: f.write(body)
   os.chmod(tmp,0o644);os.replace(tmp,p)
  finally:
   if os.path.exists(tmp):os.unlink(tmp)
 print('BACKUP='+str(backup))
for name,encoded in FILES.items():
 expected=base64.b64decode(encoded,validate=True)
 assert (ROOT/name).read_bytes()==expected
 print('VERIFICADO '+name+' '+hashlib.sha256(expected).hexdigest())
for rel in ('static/data/asset_registry_v365.json','static/data/portfolio_br_v365.json'):
 print(('DADO_EXISTENTE=' if (ROOT/rel).is_file() else 'DEPENDENCIA_DADOS_AUSENTE=')+rel)
print('PATCH_MOEDAS_COTACOES_V108_OK; SERVICOS_NAO_INICIADOS; FONTES_DOCUMENTAIS_CONFIGURADAS; DADOS_FINANCEIROS_E_MODELOS_NAO_ALTERADOS')
PYTHON
