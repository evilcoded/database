#!/bin/bash
set -euo pipefail
umask 077
"$HOME/anaconda3/bin/python" -I -B - "$@" <<'PYTHON'
from pathlib import Path
import base64,hashlib,datetime,shutil,os,tempfile,sys,json
ROOT=Path('/Applications/Bridge_Companion/porquinho_v33_web_foundation-2')
FILES={'universal_portfolio/cash_execution_cost_projection_a24.py': '', 'universal_portfolio/manual_execution_availability_a24.py': '', 'universal_portfolio/learned_cash_plan_transport_a24.py': '', 'universal_portfolio/monitor_consolidation_a24.py': '', 'static/experience_panels_v37.js': ''}
BASELINES={'universal_portfolio/cash_execution_cost_projection_a24.py': (), 'universal_portfolio/manual_execution_availability_a24.py': (), 'universal_portfolio/learned_cash_plan_transport_a24.py': ('8d302c8394f0a5ad404a1b3147d5321c552999031a71850d73347e7d2cd33e1e',), 'universal_portfolio/monitor_consolidation_a24.py': ('ac55b6c07ed504681c438e6083d0069cf7478956003ab434684b2ee653dc3c7c',), 'static/experience_panels_v37.js': ('3641412434482a372894c33964c748108c122cc8c99d6150225b9770d69e9621',)}
assert (ROOT/'webapp/server.py').is_file(), 'PROJETO_NAO_ENCONTRADO'
assert not ROOT.is_symlink(), 'SYMLINK_RECUSADO'
# Optional user-reported route fact, supplied as arguments rather than bank/asset rules.
declaration=None;declaration_path=None
assert len(sys.argv) in (1,5), 'USE_ACCOUNT_INSTRUMENT_CURRENCY_STATUS'
if len(sys.argv)==5:
 aid,iid,cur,status=sys.argv[1:]
 assert status in ('AVAILABLE','UNAVAILABLE','UNKNOWN'), 'DECLARATION_STATUS_INVALID'
 registry=json.loads((ROOT/'data/institution_accounts.json').read_text())
 matches=[r for r in registry.get('accounts',[]) if r.get('account_id')==aid and r.get('currency')==cur]
 assert len(matches)==1, 'EXACT_REGISTERED_ACCOUNT_CURRENCY_REQUIRED'
 catalog=json.loads((ROOT/'data/universal_instrument_catalog.json').read_text())
 assert len([r for r in catalog.get('instruments',[]) if r.get('instrument_id')==iid])==1, 'EXACT_CATALOG_INSTRUMENT_REQUIRED'
 directory=ROOT/'data/manual_execution_availability_a24'
 assert not any(p.is_symlink() for p in [directory,*directory.parents]), 'DECLARATION_SYMLINK_REFUSED'
 relevant=[]
 paths=list(directory.glob('*.json')) if directory.exists() else []
 assert len(paths)<1024, 'DECLARATION_LIMIT'
 def declaration_digest(row):
  return hashlib.sha256(json.dumps({k:v for k,v in row.items() if k!='record_id'},sort_keys=True,separators=(',',':'),ensure_ascii=False).encode()).hexdigest()
 for p in paths:
  assert not p.is_symlink() and p.stat().st_size<=65536, 'DECLARATION_FILE_INVALID'
  r=json.loads(p.read_text());assert r.get('record_id')==declaration_digest(r) and p.stem==r['record_id'], 'DECLARATION_INTEGRITY_INVALID'
  if (r.get('account_id'),r.get('instrument_id'),r.get('currency'),r.get('channel'))==(aid,iid,cur,'BANK_APP'):relevant.append(r)
 latest=max((datetime.datetime.fromisoformat(r['observed_at']) for r in relevant),default=None)
 current=[r for r in relevant if datetime.datetime.fromisoformat(r['observed_at'])==latest]
 if not current or {r.get('status') for r in current}!={status}:
  declaration={'schema':'porquinho.manual-execution-availability-a24/1.0','account_id':aid,'instrument_id':iid,'currency':cur,'channel':'BANK_APP','status':status,'observed_at':datetime.datetime.now(datetime.timezone.utc).isoformat(),'source_kind':'USER_REPORT','source_note':'Manual confirmation supplied by the user; revisable by a subsequent declaration.'}
  declaration['record_id']=declaration_digest(declaration);declaration_path=directory/(declaration['record_id']+'.json')

prepared=[]
for name,encoded in FILES.items():
 p=ROOT/name
 assert not any(a.is_symlink() for a in [p,*p.parents]), 'SYMLINK_RECUSADO'
 assert all(not a.exists() or a.is_dir() for a in p.parents), 'PASTA_INVALIDA: '+name
 body=base64.b64decode(encoded,validate=True)
 if p.is_file() and p.read_bytes()==body: continue
 if p.exists():
  assert p.is_file(), 'DESTINO_INVALIDO: '+name
  assert hashlib.sha256(p.read_bytes()).hexdigest() in BASELINES[name], 'BASE_DIVERGENTE_PRESERVADA: '+name+' SHA256='+hashlib.sha256(p.read_bytes()).hexdigest()
 if name.endswith('.py'):compile(body,str(p),'exec')
 prepared.append((name,p,body))
backup=ROOT/('.a24_manual_route_costs_v64_'+datetime.datetime.now().strftime('%Y%m%d_%H%M%S_%f'))
if prepared:
 backup.mkdir(mode=0o700)
 for name,p,body in prepared:
  if p.exists():
   dest=backup/name;dest.parent.mkdir(parents=True,exist_ok=True);shutil.copy2(p,dest)
 for name,p,body in prepared:
  p.parent.mkdir(parents=True,exist_ok=True)
  fd,tmp=tempfile.mkstemp(prefix='.recovery-',dir=p.parent)
  try:
   with os.fdopen(fd,'wb') as f: f.write(body)
   os.chmod(tmp,0o644);os.replace(tmp,p)
  finally:
   if os.path.exists(tmp):os.unlink(tmp)
 print('BACKUP='+str(backup))
for name,encoded in FILES.items():
 expected=base64.b64decode(encoded,validate=True)
 assert (ROOT/name).read_bytes()==expected
 print('VERIFICADO '+name+' '+hashlib.sha256(expected).hexdigest())
for rel in ('static/data/asset_registry_v365.json','static/data/portfolio_br_v365.json'):
 print(('DADO_EXISTENTE=' if (ROOT/rel).is_file() else 'DEPENDENCIA_DADOS_AUSENTE=')+rel)
if declaration is not None:
 declaration_path.parent.mkdir(parents=True,exist_ok=True)
 raw=json.dumps(declaration,ensure_ascii=False,sort_keys=True,indent=2).encode()
 fd,tmp=tempfile.mkstemp(prefix='.declaration-',dir=declaration_path.parent)
 try:
  with os.fdopen(fd,'wb') as f:f.write(raw)
  os.chmod(tmp,0o600);os.replace(tmp,declaration_path)
 finally:
  if os.path.exists(tmp):os.unlink(tmp)
 assert json.loads(declaration_path.read_bytes())==declaration
 print('DECLARACAO_MANUAL_REGISTRADA='+str(declaration_path))
elif len(sys.argv)==5:print('DECLARACAO_MANUAL_JA_REGISTRADA; HISTORICO_PRESERVADO')

print('PATCH_CUSTOS_ROTA_MANUAL_V64_OK; SERVICOS_NAO_INICIADOS; DADOS_FINANCEIROS_E_MODELOS_NAO_ALTERADOS')
PYTHON
