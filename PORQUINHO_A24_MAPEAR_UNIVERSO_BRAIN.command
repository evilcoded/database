#!/bin/bash
set -euo pipefail
umask 077
ROOT="${PORQUINHO_ROOT:-$HOME/Desktop/Bridge_Companion/porquinho_v33_web_foundation-2}"
PYTHON_BIN="python3"
if [ -x "$ROOT/.venv/bin/python" ]; then PYTHON_BIN="$ROOT/.venv/bin/python"; fi
"$PYTHON_BIN" -I -B - "$ROOT" <<'A24_BRAIN_MAP'
import sys
if sys.version_info < (3,10):raise SystemExit('Python 3.10+ necessário.')
import json,os,subprocess,zipfile,hashlib
from pathlib import Path
from datetime import datetime
from zoneinfo import ZoneInfo
CHILD='"""Export identifiers and lineage only, never financial values or inferred bindings."""\nimport csv,hashlib,json,math,os,sys\nfrom pathlib import Path\nfrom datetime import date\n\nMAX_JSON=32*1024*1024\n\ndef text(v):return isinstance(v,str) and bool(v) and len(v)<=512 and v==v.strip()\ndef scalar(v):return v if text(v) else None\n\ndef inspect(root):\n root=Path(root).resolve(strict=True);tracked={}\n def local(rel):\n  p=root/rel\n  if p.is_symlink() or any(a.is_symlink() for a in p.parents if a!=root.parent):raise ValueError(\'SOURCE_SYMLINK_REFUSED\')\n  if not p.resolve().is_relative_to(root):raise ValueError(\'SOURCE_OUTSIDE_PROJECT\')\n  return p\n def sig(p):\n  if not p.exists():return None\n  s=p.stat();return (s.st_dev,s.st_ino,s.st_size,s.st_mtime_ns)\n def read(rel):\n  p=local(rel);tracked[p]=sig(p)\n  if tracked[p] is None:return None\n  if tracked[p][2]>MAX_JSON:raise ValueError(\'JSON_SIZE_LIMIT\')\n  return json.loads(p.read_text(encoding=\'utf-8\'))\n lab=read(\'results/prediction_lab.json\')\n if not isinstance(lab,dict):raise ValueError(\'PREDICTION_LAB_MISSING_OR_INVALID\')\n fields=(\'asset\',\'instrument_id\',\'provider\',\'provider_id\',\'quote_currency\',\'price_unit_status\')\n cases={};group_counts={};invalid=0\n for group in (\'predictions\',\'ensemble_predictions\'):\n  rows=lab.get(group) or []\n  if not isinstance(rows,list) or len(rows)>10000:raise ValueError(\'PREDICTION_ROWS_INVALID\')\n  group_counts[group]=len(rows)\n  for row in rows:\n   if not isinstance(row,dict) or not text(row.get(\'asset\')):invalid+=1;continue\n   selected={k:scalar(row.get(k)) for k in fields};key=tuple(selected[k] for k in fields)\n   if key not in cases:cases[key]={**selected,\'groups\':[],\'observation_dates\':[]}\n   item=cases[key];item[\'groups\'].append(group) if group not in item[\'groups\'] else None\n   try:d=date.fromisoformat(row.get(\'date\',\'\')).isoformat()\n   except (ValueError,TypeError):d=None\n   if d and d not in item[\'observation_dates\']:item[\'observation_dates\'].append(d)\n out={\'validation\':\'A24_BRAIN_UNIVERSE_REVIEW_READ_ONLY\',\'status\':\'COLLECTED_IDENTIFIERS_NOT_VALIDATED\',\n      \'prediction_group_counts\':group_counts,\'unique_prediction_context_count\':len(cases),\n      \'invalid_prediction_row_count\':invalid,\'trained_at\':scalar(lab.get(\'trained_at\')),\n      \'cases\':list(cases.values()),\'catalog_identity_references\':[],\n      \'identity_binding_created\':False,\'financial_values_exported\':False,\'canonical_publication_authorized\':False}\n latest=read(\'results/latest.json\')\n score_rows=latest.get(\'scores\',[]) if isinstance(latest,dict) else []\n if not isinstance(score_rows,list) or len(score_rows)>10000:raise ValueError(\'SCORE_ROWS_INVALID\')\n out[\'latest_score_observations\']=[{k:scalar(row.get(k)) for k in (\'asset\',\'instrument_id\',\'provider\',\'provider_id\',\'quote_currency\')} for row in score_rows if isinstance(row,dict) and text(row.get(\'asset\'))]\n out[\'scope\']=\'PERSISTED_LAB_PREDICTIONS_AND_LATEST_SCORES; NOT_ALL_IN_MEMORY_SHADOW_CANDIDATES\'\n labels={v[\'asset\'] for v in cases.values()}\n histories={};bound={};market=local(\'data/database/market_daily.csv\');tracked[market]=sig(market)\n if tracked[market] is not None:\n  if tracked[market][2]>512*1024*1024:raise ValueError(\'MARKET_SIZE_LIMIT\')\n  with market.open(newline=\'\',encoding=\'utf-8\') as f:\n   for n,row in enumerate(csv.DictReader(f),1):\n    if n>2000000:raise ValueError(\'MARKET_ROW_LIMIT\')\n    label=scalar(row.get(\'asset\'))\n    if label not in labels:continue\n    h=histories.setdefault(label,{\'rows\':0,\'rows_with_explicit_identity_origin\':0,\'first_date\':None,\'latest_date\':None})\n    h[\'rows\']+=1\n    complete=all(text(row.get(k)) for k in (\'instrument_id\',\'provider\',\'provider_id\',\'quote_currency\'))\n    if complete:h[\'rows_with_explicit_identity_origin\']+=1\n    try:day=date.fromisoformat(row.get(\'date\',\'\')).isoformat()\n    except (TypeError,ValueError):continue\n    h[\'first_date\']=min(h[\'first_date\'],day) if h[\'first_date\'] else day\n    h[\'latest_date\']=max(h[\'latest_date\'],day) if h[\'latest_date\'] else day\n    if complete:\n     key=(row[\'instrument_id\'],row[\'provider\'].lower(),row[\'provider_id\'],row[\'quote_currency\'],day)\n     bound[key]=bound.get(key,0)+1\n references={}\n for rel in (\'data/universal_instrument_catalog.json\',\'data/instruments/manual_instruments.json\'):\n  obj=read(rel)\n  if obj is None:continue\n  if not isinstance(obj,dict) or not isinstance(obj.get(\'instruments\',[]),list):raise ValueError(\'CATALOG_SCHEMA_INVALID\')\n  for row in obj.get(\'instruments\',[]):\n   if not isinstance(row,dict) or not text(row.get(\'instrument_id\')):continue\n   selected={k:scalar(row.get(k)) for k in (\'instrument_id\',\'symbol\',\'asset_class\',\'market\',\'jurisdiction\')}\n   selected[\'source\']=rel;references[(row[\'instrument_id\'],rel)]=selected\n out[\'catalog_identity_references\']=list(references.values())\n for item in out[\'cases\']:\n  item[\'history_by_exact_presentation_label\']=histories.get(item[\'asset\'])\n  item[\'label_history_is_not_canonical_identity_proof\']=True\n  complete=all(text(item.get(k)) for k in (\'instrument_id\',\'provider\',\'provider_id\',\'quote_currency\'))\n  item[\'review_status\']=\'EXPLICIT_METADATA_REQUIRES_REVIEW\' if complete else \'MISSING_EXPLICIT_IDENTITY_OR_ORIGIN\'\n  item[\'exact_start_observation_counts\']=({d:bound.get((item[\'instrument_id\'],item[\'provider\'].lower(),item[\'provider_id\'],item[\'quote_currency\'],d),0) for d in item[\'observation_dates\']} if complete else None)\n changed=[str(p.relative_to(root)) for p,before in tracked.items() if sig(p)!=before]\n out[\'source_files_stable_during_read\']=not changed\n if changed:\n  out[\'status\']=\'SOURCE_CHANGED_DURING_READ_RETRY_REQUIRED\';out[\'cases\']=[];out[\'catalog_identity_references\']=[]\n return out\n\n\ndef canonical_held(root):\n """Guarded call to the application\'s actual verified runtime read model."""\n from decimal import Decimal\n from universal_portfolio.canonical_runtime_read_model import build\n value=build(root);ids=set();unavailable=0\n for position in value[\'positions\']:\n  quantity=position.quantity\n  if quantity is None:unavailable+=1;continue\n  q=Decimal(str(quantity))\n  if not q.is_finite():unavailable+=1;continue\n  if q==0:continue\n  iid=position.instrument_id\n  if text(iid):ids.add(iid)\n  else:unavailable+=1\n return {\'status\':\'VERIFIED_RUNTIME_READ_MODEL_IDENTITIES_ONLY\',\'active_instrument_ids\':sorted(ids),\n         \'unavailable_position_identity_or_quantity_count\':unavailable,\n         \'financial_values_exported\':False,\'ownership_inferred_from_catalog\':False}\n\n\ndef main(expected_read_model_hash):\n root=Path(sys.argv[1]).resolve(strict=True);sys.path.insert(0,str(root));opened={}\n def signature(p):\n  try:s=p.stat();return (s.st_dev,s.st_ino,s.st_size,s.st_mtime_ns)\n  except OSError:return None\n def guard(event,args):\n  if event==\'open\':\n   mode,flags=args[1:3]\n   if (isinstance(mode,str) and any(c in mode for c in \'wax+\')) or (isinstance(flags,int) and flags & (os.O_WRONLY|os.O_RDWR|os.O_CREAT|os.O_TRUNC|os.O_APPEND)):raise RuntimeError(\'READ_ONLY_WRITE_REFUSED\')\n   if isinstance(args[0],(str,bytes,os.PathLike)):\n    p=Path(os.fsdecode(args[0]))\n    if p.is_absolute() and (p.is_relative_to(root/\'data\') or p.is_relative_to(root/\'results\')):opened.setdefault(p,signature(p))\n  if event in {\'os.remove\',\'os.rename\',\'os.mkdir\',\'os.rmdir\',\'os.chmod\',\'os.truncate\',\'os.link\',\'os.symlink\',\'subprocess.Popen\',\'os.system\',\'socket.connect\',\'socket.bind\'}:raise RuntimeError(\'READ_ONLY_SIDE_EFFECT_REFUSED\')\n sys.addaudithook(guard)\n try:\n  out=inspect(root)\n  readmodel=root/\'universal_portfolio/canonical_runtime_read_model.py\'\n  if not readmodel.is_file():\n   out[\'portfolio\']={\'status\':\'UNAVAILABLE_NO_LEGACY_FALLBACK\',\'error\':\'ReadModelSourceMissing\',\'active_instrument_ids\':None}\n  elif readmodel.is_symlink() or hashlib.sha256(readmodel.read_bytes()).hexdigest()!=expected_read_model_hash:\n   out[\'portfolio\']={\'status\':\'READ_MODEL_SOURCE_HASH_MISMATCH\',\'active_instrument_ids\':None}\n  else:\n   try:out[\'portfolio\']=canonical_held(root)\n   except Exception as exc:out[\'portfolio\']={\'status\':\'UNAVAILABLE_NO_LEGACY_FALLBACK\',\'error\':type(exc).__name__,\'active_instrument_ids\':None}\n  changed=any(signature(p)!=old for p,old in opened.items())\n  if changed:\n   out[\'portfolio\']={\'status\':\'SOURCE_CHANGED_DURING_READ_RETRY_REQUIRED\',\'active_instrument_ids\':None}\n   out[\'source_files_stable_during_read\']=False;out[\'status\']=\'SOURCE_CHANGED_DURING_READ_RETRY_REQUIRED\'\n   out[\'cases\']=[];out[\'catalog_identity_references\']=[]\n  known=out[\'portfolio\'].get(\'active_instrument_ids\')\n  for item in out[\'cases\']:\n   item[\'portfolio_exact_identity_match\']=(item[\'instrument_id\'] in known if item[\'instrument_id\'] and known is not None else None)\n  out[\'portfolio_symbol_or_suffix_matching_performed\']=False\n except Exception as exc:out={\'validation\':\'A24_BRAIN_UNIVERSE_REVIEW_READ_ONLY\',\'status\':\'FAILED_CLOSED\',\'error\':type(exc).__name__}\n print(json.dumps(out,ensure_ascii=False,indent=2))\n\nif __name__==\'__main__\':main(\'18a840442c8efe742b1fdfb2084491eb6425d800fb11a4b26fc33a7524bccdbd\')\n'
root=Path(sys.argv[1]).expanduser().resolve(strict=True)
result=subprocess.run([sys.executable,'-I','-B','-c',CHILD,str(root)],cwd=root,capture_output=True,text=True,timeout=120,check=True)
report=json.loads(result.stdout)
if report.get('status')!='COLLECTED_IDENTIFIERS_NOT_VALIDATED' or not report.get('source_files_stable_during_read'):
 print(json.dumps(report,ensure_ascii=False,indent=2))
 raise SystemExit('COLETA_NAO_CONCLUIDA: fontes ausentes ou alteradas; nenhum pacote de revisão criado.')
destination=Path(os.environ.get('PORQUINHO_REVIEW_DIR',str(Path.home()/'Downloads'))).expanduser().resolve()
if destination.is_relative_to(root):raise SystemExit('Destino precisa ficar fora do projeto.')
destination.mkdir(exist_ok=True)
stamp=datetime.now(ZoneInfo('Europe/Lisbon')).strftime('%Y%m%d_%H%M%S_%f')
path=destination/('PORQUINHO_A24_UNIVERSO_BRAIN_'+stamp+'.zip')
data=json.dumps(report,ensure_ascii=False,indent=2).encode('utf-8')
manifest={'report_sha256':hashlib.sha256(data).hexdigest(),'contents':'IDENTIFIERS_AND_LINEAGE_ONLY','financial_values_exported':False,'project_mutation':False}
with zipfile.ZipFile(path,'x',compression=zipfile.ZIP_DEFLATED) as package:
 package.writestr('BRAIN_UNIVERSE_REVIEW.json',data)
 package.writestr('MANIFEST.json',json.dumps(manifest,indent=2))
portfolio=report.get('portfolio') or {}
print(json.dumps({'status':'REVIEW_PACKAGE_CREATED_NOT_VALIDATED','prediction_group_counts':report['prediction_group_counts'],'unique_prediction_context_count':report['unique_prediction_context_count'],'latest_score_observation_count':len(report['latest_score_observations']),'portfolio_read_status':portfolio.get('status'),'portfolio_active_identity_count':len(portfolio['active_instrument_ids']) if isinstance(portfolio.get('active_instrument_ids'),list) else None,'financial_values_exported':False,'identity_binding_created':False,'services_restarted':False,'canonical_publication_authorized':False},ensure_ascii=False,indent=2))
print('ZIP_PARA_COMPARTILHAR='+str(path))
print('O ZIP contém identificadores e contexto para revisão; não contém saldos, quantidades, contas ou valores de previsões.')
A24_BRAIN_MAP
