#!/bin/bash
set -euo pipefail
umask 077
"$HOME/anaconda3/bin/python" -I -B - <<'PYTHON'
from pathlib import Path
import base64,hashlib,datetime,shutil,os,tempfile
ROOT=Path('/Applications/Bridge_Companion/porquinho_v33_web_foundation-2')
FILES={'universal_portfolio/read_inspection_scope_a24.py': '', 'universal_portfolio/monitor_consolidation_a24.py': '', 'universal_portfolio/global_history_source_a24.py': '', 'universal_portfolio/recovered_history_composition_a24.py': '', 'brain/evolution/global_research_lab_a24.py': ''}
BASELINES={'universal_portfolio/read_inspection_scope_a24.py': [], 'universal_portfolio/monitor_consolidation_a24.py': ['0692942e36b3e75aa182e30d34a06eed74896ccf5bdf7a16b31037e226b3145c'], 'universal_portfolio/global_history_source_a24.py': ['afa990d85c740b91bb676b63cbc3bf4e52ba4703882371e82deae33cb82767d8'], 'universal_portfolio/recovered_history_composition_a24.py': ['20abc98cea925ece54f9466beee4ebfebb4c14a309d278be74b8ce75daee367c'], 'brain/evolution/global_research_lab_a24.py': ['db0d577b3e97a8307084cc7905fcde5ea2d3a365342f00d76840f7bd4cd1f967']}
assert (ROOT/'webapp/server.py').is_file(), 'PROJETO_NAO_ENCONTRADO'
assert not ROOT.is_symlink(), 'SYMLINK_RECUSADO'
for rel in ('data/brain/system_knowledge/registry.json','data/brain/system_knowledge/history'):
 p=ROOT/rel
 assert not any(a.is_symlink() for a in [p,*p.parents]), 'SYMLINK_CONHECIMENTO_RECUSADO'
DEPENDENCIES={'universal_portfolio/suggestion_consolidation_a24.py': 'cf947658c731789472add9666d98f1935f698264e8aaf754e31499375537ed8b', 'universal_portfolio/global_operational_plan_a24.py': '275d74ba3ea915717393b5dfac33ee06f660964f559851338e24144955836830', 'universal_portfolio/consolidation_validation_a24.py': '77b86c1ee63e15959a4627c007dd7b0cf83ab2466f42d4a3f3525e7dda34adbc', 'static/decision_dashboard_v147.js': 'e813d7c7d7f6c3a297c4d8a91f702d30b1e6cf74da2cecd999aec9aa9c7a6341', 'static/decision_dashboard_v147.css': '3efffb5eeb5cb2a589cc4668289e63e2777cb37bef328c65a9051a1b9f7ecf74', 'static/dashboard_layout_v148.js': '1c4305c380aec2d8b36b8e5c65aeac1c50cf7f11a941fe067a7fa3620f4403d7', 'static/dashboard_layout_v148.css': 'f0b8e170116a207903848f42700566e836dff1da3c535588b5da6e92eefef3e8', 'static/fixed_dashboard_v149.js': '76f212344d18f2bb12ae6ef727f3db6a753f8c4e9597b7a970780a2847cfde6b', 'static/fixed_dashboard_v149.css': 'd378ab560fd031470e68e6ac843185f829ff475336a9a3e635f797c955e66c38', 'static/dashboard_finish_v150.js': 'a7cdcb26d48b6a8eec06125199f427ee160aa5414beee99b6d5abfaf00a7b77b', 'static/dashboard_finish_v150.css': '7d12acbf5584c6f74723b69a6fba7e6caaf2fc454fc98362743ed5808fe4e339'}
for rel,expected in DEPENDENCIES.items():
 p=ROOT/rel
 assert p.is_file() and not any(a.is_symlink() for a in [p,*p.parents]) and hashlib.sha256(p.read_bytes()).hexdigest()==expected, 'BASE_COMPATIVEL_V152_REQUERIDA: '+rel
prepared=[]
for name,encoded in FILES.items():
 p=ROOT/name
 assert not any(a.is_symlink() for a in [p,*p.parents]), 'SYMLINK_RECUSADO'
 assert all(not a.exists() or a.is_dir() for a in p.parents), 'PASTA_INVALIDA: '+name
 assert p.is_file() or not BASELINES[name], 'BASE_AUSENTE: '+name
 body=base64.b64decode(encoded,validate=True)
 if p.is_file() and p.read_bytes()==body: continue
 if p.exists():
  assert p.is_file(), 'DESTINO_INVALIDO: '+name
  assert hashlib.sha256(p.read_bytes()).hexdigest() in BASELINES[name], 'BASE_DIVERGENTE_PRESERVADA: '+name+' SHA256='+hashlib.sha256(p.read_bytes()).hexdigest()
 if name.endswith('.py'):compile(body,str(p),'exec')
 prepared.append((name,p,body))
backup=ROOT/('.a24_dashboard_read_v152_'+datetime.datetime.now().strftime('%Y%m%d_%H%M%S_%f'))
if prepared:
 backup.mkdir(mode=0o700)
 for name,p,body in prepared:
  if p.exists():
   dest=backup/name;dest.parent.mkdir(parents=True,exist_ok=True);shutil.copy2(p,dest)
 for name,p,body in prepared:
  p.parent.mkdir(parents=True,exist_ok=True)
  fd,tmp=tempfile.mkstemp(prefix='.recovery-',dir=p.parent)
  try:
   with os.fdopen(fd,'wb') as f: f.write(body)
   os.chmod(tmp,0o644);os.replace(tmp,p)
  finally:
   if os.path.exists(tmp):os.unlink(tmp)
 print('BACKUP='+str(backup))
for name,encoded in FILES.items():
 expected=base64.b64decode(encoded,validate=True)
 assert (ROOT/name).read_bytes()==expected
 print('VERIFICADO '+name+' '+hashlib.sha256(expected).hexdigest())
for rel in ('static/data/asset_registry_v365.json','static/data/portfolio_br_v365.json'):
 print(('DADO_EXISTENTE=' if (ROOT/rel).is_file() else 'DEPENDENCIA_DADOS_AUSENTE=')+rel)
import sys
sys.path.insert(0,str(ROOT))
from brain.knowledge.system_registry import SystemKnowledgeRegistry
from universal_portfolio.consolidation_validation_a24 import validate
validation=validate()
assert validation['status']=='FIVE_ACTION_FLOWS_VALIDATED_WITH_CONTROL_SCENARIOS'
print('CINCO_FLUXOS_VALIDADOS; EUR_E_BRL; CENARIOS_CONTROLADOS; SEM_COLETA_OU_ALTERACAO_FINANCEIRA')
registry=SystemKnowledgeRegistry(ROOT)
if not registry.verify()['current']:registry.refresh()
state=registry.verify()
assert state['current'], 'CONHECIMENTO_AINDA_DIVERGENTE'
print('CONHECIMENTO_DESCRITIVO_ATUALIZADO; DIVERGENCIAS='+str(state['stale_count'])+'; SEM_VALIDACAO_FINANCEIRA')
print('PATCH_LEITURA_DASHBOARD_V152_OK; SERVICOS_NAO_INICIADOS; REUSO_LIMITADO_A_LEITURA_ATUAL; VALIDACOES_E_RESULTADOS_PRESERVADOS; SEM_CACHE_PERSISTENTE; SEM_ALTERACAO_FINANCEIRA')
PYTHON
if [[ "${1:-}" == "--reiniciar" ]]; then
  "$HOME/anaconda3/bin/python" -I -B "/Applications/Bridge_Companion/porquinho_v33_web_foundation-2/tools/restart_porquinho_checked_a24.py"
fi
