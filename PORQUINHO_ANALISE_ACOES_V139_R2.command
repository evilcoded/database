#!/bin/bash
set -euo pipefail
umask 077
"$HOME/anaconda3/bin/python" -I -B - <<'PYTHON'
from pathlib import Path
import base64,hashlib,datetime,shutil,os,tempfile
ROOT=Path('/Applications/Bridge_Companion/porquinho_v33_web_foundation-2')
FILES={'equities/__init__.py': '', 'equities/contract.py': '', 'equities/market.py': '', 'equities/fundamentals.py': '', 'equities/technical.py': '', 'equities/risk_regime.py': '', 'equities/opportunity.py': '', 'universal_portfolio/equity_analysis_pipeline_a24.py': '', 'equities/historical.py': '', 'universal_portfolio/universal_observation_bridge.py': '', 'universal_portfolio/operational_cycle_a24.py': '', 'tools/diagnose_decision_pipeline_a24.py': '', 'webapp/server.py': ''}
BASELINES={'universal_portfolio/equity_analysis_pipeline_a24.py': [], 'equities/historical.py': ['d3dbcbd1d8f0134c4560f66273e8f9557a9c3addaa95fd572c77a0e6de13cdbf'], 'universal_portfolio/universal_observation_bridge.py': ['75b3bd4d3ccd659a0cb4837d5a0e89472562f91a53b8e29fd66959140df74b2c'], 'universal_portfolio/operational_cycle_a24.py': ['226638051795c7b6127856e4b0f05848db450771c5a86b2a33d3bb073ea3f42b'], 'tools/diagnose_decision_pipeline_a24.py': ['98bf19a1078367af9ada7eb104513494fb3c485e48574be3065e1c9b6aed45c0'], 'webapp/server.py': ['fdc8299cab4ebec17b028c410419875f3d86b8a465991508754f4fe68f7eb32a'], 'equities/__init__.py': ['9d0000426f4414ff1db4d36a22021d2da6eb8cd47a2aeeb948fbdba37aabe67d'], 'equities/contract.py': ['3efdf0f73da38366df2e73c924a6b21f27e745a6402244b9d6732023e231440a'], 'equities/market.py': ['4ec3e0837adbb7857521950c99552de7a0899826dbf9f3edd0d79072a903dcf2'], 'equities/fundamentals.py': ['d6624da02ed373f947a04ec35b15e66fd499c982d60adc8763fbdf9f03bed897'], 'equities/technical.py': ['59acfff8b6e5e38ba6a6b3d25db5d5964d45d7ecad9d83083d7149b7d56c14de'], 'equities/risk_regime.py': ['5124a38f2db4f51bf273fe3baaaf2fb704606f9deeec803508b3bd8160e44ef0'], 'equities/opportunity.py': ['f11eb11b2b799f05a44a36ac9c698880f999337ef7ca1d4dfc7641eda9d6c151']}
ALLOW_MISSING=['equities/__init__.py', 'equities/contract.py', 'equities/market.py', 'equities/fundamentals.py', 'equities/technical.py', 'equities/risk_regime.py', 'equities/opportunity.py', 'equities/historical.py']
assert (ROOT/'webapp/server.py').is_file(), 'PROJETO_NAO_ENCONTRADO'
assert not ROOT.is_symlink(), 'SYMLINK_RECUSADO'
prepared=[]
for name,encoded in FILES.items():
 p=ROOT/name
 assert not any(a.is_symlink() for a in [p,*p.parents]), 'SYMLINK_RECUSADO'
 assert all(not a.exists() or a.is_dir() for a in p.parents), 'PASTA_INVALIDA: '+name
 assert p.is_file() or not BASELINES[name] or name in ALLOW_MISSING, 'BASE_AUSENTE: '+name
 body=base64.b64decode(encoded,validate=True)
 if p.is_file() and p.read_bytes()==body: continue
 if p.exists():
  assert p.is_file(), 'DESTINO_INVALIDO: '+name
  assert hashlib.sha256(p.read_bytes()).hexdigest() in BASELINES[name], 'BASE_DIVERGENTE_PRESERVADA: '+name+' SHA256='+hashlib.sha256(p.read_bytes()).hexdigest()
 if name.endswith('.py'):compile(body,str(p),'exec')
 prepared.append((name,p,body))
backup=ROOT/('.a24_equity_source_analysis_v139_r2_'+datetime.datetime.now().strftime('%Y%m%d_%H%M%S_%f'))
if prepared:
 backup.mkdir(mode=0o700)
 for name,p,body in prepared:
  if p.exists():
   dest=backup/name;dest.parent.mkdir(parents=True,exist_ok=True);shutil.copy2(p,dest)
 for name,p,body in prepared:
  p.parent.mkdir(parents=True,exist_ok=True)
  fd,tmp=tempfile.mkstemp(prefix='.recovery-',dir=p.parent)
  try:
   with os.fdopen(fd,'wb') as f: f.write(body)
   os.chmod(tmp,0o644);os.replace(tmp,p)
  finally:
   if os.path.exists(tmp):os.unlink(tmp)
 print('BACKUP='+str(backup))
for name,encoded in FILES.items():
 expected=base64.b64decode(encoded,validate=True)
 assert (ROOT/name).read_bytes()==expected
 print('VERIFICADO '+name+' '+hashlib.sha256(expected).hexdigest())
for rel in ('static/data/asset_registry_v365.json','static/data/portfolio_br_v365.json'):
 print(('DADO_EXISTENTE=' if (ROOT/rel).is_file() else 'DEPENDENCIA_DADOS_AUSENTE=')+rel)
print('PATCH_ANALISE_ACOES_V139_R2_OK; SERVICOS_NAO_INICIADOS; CALCULOS_EXISTENTES_CONECTADOS; SEM_PROMOCAO_DE_INDICES_OU_MODELOS; DADOS_FINANCEIROS_E_MODELOS_NAO_ALTERADOS')
PYTHON
if [[ "${1:-}" == "--reiniciar" ]]; then
  "$HOME/anaconda3/bin/python" -I -B "/Applications/Bridge_Companion/porquinho_v33_web_foundation-2/tools/restart_porquinho_checked_a24.py"
fi
