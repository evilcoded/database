#!/bin/bash
set -euo pipefail
umask 077
"$HOME/anaconda3/bin/python" -I -B - <<'PYTHON'
from pathlib import Path
import base64,hashlib,datetime,shutil,os,tempfile
ROOT=Path('/Applications/Bridge_Companion/porquinho_v33_web_foundation-2')
FILES={'porquinho.py': '', 'static/balance_accounts_v41.css': '', 'static/balance_accounts_v41.js': '', 'static/blue_experience_v38.js': '', 'static/dashboard_universal_v35.js': '', 'static/experience_panels_v37.js': '', 'templates/index.html': '', 'universal_portfolio/experience_panels_a24.py': '', 'universal_portfolio/global_action_readings_a24.py': '', 'universal_portfolio/global_dashboard_observations_a24.py': '', 'universal_portfolio/global_goal_preview_a24.py': '', 'universal_portfolio/monitor_consolidation_a24.py': '', 'universal_portfolio/universal_action_rules_a24.py': '', 'webapp/server.py': ''}
BASELINES={'porquinho.py': ('7c5db8b0f65d1885c766590de34f41b9d601249d09eea28e2ce601294cc8b590',), 'static/balance_accounts_v41.css': ('3f5236fa544837aa04fb7e46dab94ed7bbcc61ecb248df23d36cc818c7daf33a',), 'static/balance_accounts_v41.js': ('adf7db12084e1965241aa29c0d84c57c53a4d74260fb7bc6849931fef3f7c94d',), 'static/blue_experience_v38.js': ('fbc8d3cd8bda2ab708af3cd9d2f2e5b3e87a7b579ea312656ab8273e0fcbeeae',), 'static/dashboard_universal_v35.js': ('2b61a015f2a2b751cdef96d38d13586efeabaaafcc07672021bf4c8b0078fd1c',), 'static/experience_panels_v37.js': ('3dc92e34bd4f5ddb4995be1d763a5ce74bccc846658e371c62694039ce0d2d9f',), 'templates/index.html': ('97837611d903daa931416b7940cfaa995bfe21ca33941cdc7924ebed51dcf416',), 'universal_portfolio/experience_panels_a24.py': ('f34b909823dc8d009e8454734fe0538366189692d5e96f0e94ca95bec1721af6',), 'universal_portfolio/global_action_readings_a24.py': (), 'universal_portfolio/global_dashboard_observations_a24.py': (), 'universal_portfolio/global_goal_preview_a24.py': (), 'universal_portfolio/monitor_consolidation_a24.py': ('b36eb198a3eb9469034f2360c61e17d705008310b4c5e41259a4649606dce40e',), 'universal_portfolio/universal_action_rules_a24.py': (), 'webapp/server.py': ('fd0538a6b90080b220fff8c1ae84ffe77b9ed53f6dc5cb6955940c4794d41c1a',)}
assert (ROOT/'webapp/server.py').is_file(), 'PROJETO_NAO_ENCONTRADO'
assert not ROOT.is_symlink(), 'SYMLINK_RECUSADO'
prepared=[]
for name,encoded in FILES.items():
 p=ROOT/name
 assert not any(a.is_symlink() for a in [p,*p.parents]), 'SYMLINK_RECUSADO'
 assert all(not a.exists() or a.is_dir() for a in p.parents), 'PASTA_INVALIDA: '+name
 assert p.is_file() or not BASELINES[name], 'BASE_AUSENTE: '+name
 body=base64.b64decode(encoded,validate=True)
 if p.is_file() and p.read_bytes()==body: continue
 if p.exists():
  assert p.is_file(), 'DESTINO_INVALIDO: '+name
  assert hashlib.sha256(p.read_bytes()).hexdigest() in BASELINES[name], 'BASE_DIVERGENTE_PRESERVADA: '+name+' SHA256='+hashlib.sha256(p.read_bytes()).hexdigest()
 if name.endswith('.py'):compile(body,str(p),'exec')
 prepared.append((name,p,body))
backup=ROOT/('.a24_global_dashboard_v118_'+datetime.datetime.now().strftime('%Y%m%d_%H%M%S_%f'))
if prepared:
 backup.mkdir(mode=0o700)
 for name,p,body in prepared:
  if p.exists():
   dest=backup/name;dest.parent.mkdir(parents=True,exist_ok=True);shutil.copy2(p,dest)
 for name,p,body in prepared:
  p.parent.mkdir(parents=True,exist_ok=True)
  fd,tmp=tempfile.mkstemp(prefix='.recovery-',dir=p.parent)
  try:
   with os.fdopen(fd,'wb') as f: f.write(body)
   os.chmod(tmp,0o644);os.replace(tmp,p)
  finally:
   if os.path.exists(tmp):os.unlink(tmp)
 print('BACKUP='+str(backup))
for name,encoded in FILES.items():
 expected=base64.b64decode(encoded,validate=True)
 assert (ROOT/name).read_bytes()==expected
 print('VERIFICADO '+name+' '+hashlib.sha256(expected).hexdigest())
for rel in ('static/data/asset_registry_v365.json','static/data/portfolio_br_v365.json'):
 print(('DADO_EXISTENTE=' if (ROOT/rel).is_file() else 'DEPENDENCIA_DADOS_AUSENTE=')+rel)
print('PATCH_DASHBOARD_GLOBAL_V118_OK; SERVICOS_NAO_INICIADOS; REGRAS_ORIGINAIS_PRESERVADAS; UI_GLOBAL_COMPACTA; HISTORICO_OBSERVADO_POR_MOEDA; DADOS_FINANCEIROS_E_MODELOS_NAO_ALTERADOS')
PYTHON
if [[ "${1:-}" == "--reiniciar" ]]; then
  "$HOME/anaconda3/bin/python" -I -B "/Applications/Bridge_Companion/porquinho_v33_web_foundation-2/tools/restart_porquinho_checked_a24.py"
fi
