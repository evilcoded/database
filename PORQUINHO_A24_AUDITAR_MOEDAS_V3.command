#!/bin/bash
# macOS Bash 3.2; audit only, no installation or project writes.
set -euo pipefail
umask 077
ROOT="${PORQUINHO_ROOT:-$HOME/Desktop/Bridge_Companion/porquinho_v33_web_foundation-2}"
PYTHON_BIN="python3"
if [ -x "$ROOT/.venv/bin/python" ]; then PYTHON_BIN="$ROOT/.venv/bin/python"; fi
"$PYTHON_BIN" -I -B - "$ROOT" <<'AUDIT_PARENT'
import base64,datetime,hashlib,json,os,subprocess,sys
from pathlib import Path
if sys.version_info<(3,10):raise SystemExit('Python 3.10+ necessário; projeto preservado.')
root=Path(sys.argv[1]).expanduser().resolve(strict=True)
code=base64.b64decode('')
if hashlib.sha256(code).hexdigest()!='4780d067e783927f3bd87305a35f3a923d050a1e0985087403d33015b0495a55':raise SystemExit('Integridade inválida; projeto preservado.')
result=subprocess.run([sys.executable,'-I','-B','-c',code.decode(),str(root)],capture_output=True,text=True,check=True,timeout=180)
report=json.loads(result.stdout)
output=Path(os.environ.get('PORQUINHO_AUDIT_OUTPUT',str(Path.home()/'Downloads'))).expanduser().resolve(strict=True)
if output.is_relative_to(root):raise SystemExit('Relatório deve ficar fora do projeto; projeto preservado.')
name=output/('PORQUINHO_A24_AUDITORIA_MOEDAS_'+datetime.datetime.now(datetime.timezone.utc).strftime('%Y%m%d_%H%M%S_%f')+'.json')
with open(name,'x',encoding='utf-8',opener=lambda p,f:os.open(p,f,0o600)) as stream:json.dump(report,stream,ensure_ascii=False,indent=2);stream.write('\n')
print(json.dumps({'validation':report['validation'],'status':report['status'],'market':report.get('market'),
 'episode_market_cross_check_counts':report.get('episode_market_cross_check',{}).get('counts'),
 'issues':report.get('issues',[]),'reason':report.get('reason'),'source':report.get('source'),'source_files_stable_during_read':report.get('source_files_stable_during_read'),'project_mutation':False,'currency_attribution_performed':False},ensure_ascii=False,indent=2))
print('RELATORIO_PARA_COMPARTILHAR='+str(name))
print('Projeto preservado; nenhuma moeda alterada, operação financeira, treinamento ou reinício solicitado.')
AUDIT_PARENT
