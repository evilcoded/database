#!/bin/bash
set -euo pipefail
umask 077
"$HOME/anaconda3/bin/python" -I -B - <<'PYTHON'
from pathlib import Path
import base64,hashlib,datetime,shutil,os,tempfile
ROOT=Path('/Applications/Bridge_Companion/porquinho_v33_web_foundation-2')
FILES={'universal_portfolio/capital_protection_review_a24.py': '', 'brain/knowledge/maintenance_a24.py': '', 'brain/knowledge/system_registry.py': '', 'brain/core/self_model.py': '', 'brain/patches.py': '', 'webapp/system_knowledge_api_v38268.py': '', 'universal_portfolio/experience_panels_a24.py': '', 'universal_portfolio/operational_cycle_a24.py': '', 'tools/diagnose_decision_pipeline_a24.py': '', 'static/app.js': '', 'static/dashboard_universal_v35.js': '', 'static/experience_panels_v37.js': '', 'templates/index.html': ''}
BASELINES={'universal_portfolio/capital_protection_review_a24.py': [], 'brain/knowledge/maintenance_a24.py': [], 'brain/knowledge/system_registry.py': ['b8f71fd1202e11efaebfb96e89ae89a937b14e33415c67b7b5d80799870a2630'], 'brain/core/self_model.py': ['929f283a738611179791e4702294ba6035974b83105e129439e0dd86f1dec357'], 'brain/patches.py': ['7e2d4c81fe5a9012ff640b9e97e3a6587c2018c3f6eac4bd418a0f63a0adf6e1'], 'webapp/system_knowledge_api_v38268.py': ['03f72236d5c443500f4f6717efe0d2d5f5aa28c9327afdfd099a631bc4f3079a'], 'universal_portfolio/experience_panels_a24.py': ['659df97680b7183498dd5f367e3f2129b3a220293ecb4c8d7e4ac1f7bbd5e898'], 'universal_portfolio/operational_cycle_a24.py': ['5f7815de9d1a6c954f893ff1f7c7f5d56598fe676fc984c98fc7737e53051f23'], 'tools/diagnose_decision_pipeline_a24.py': ['c7170c6d50a6dee8ab548b7eca8b3851b4350ddaae09f088cdb07f69d2d81a7b'], 'static/app.js': ['ba4fd97a3376699701d233e2ae15b1cb5aaa6b166a4f8023b594ce1643a6e446'], 'static/dashboard_universal_v35.js': ['ff00f51f79ea1c68836eb7b98fe35c675457cd9cde6c708c7c51841714c01a62'], 'static/experience_panels_v37.js': ['087009d7f854a3197033584488bdb7f9de8ee1f507da735c50ab5765a59e5f2f'], 'templates/index.html': ['80085d89065ee140b4b7d3cf24e44a1bae5e71f40428a4fe8de8dd4c70fccd84']}
assert (ROOT/'webapp/server.py').is_file(), 'PROJETO_NAO_ENCONTRADO'
assert not ROOT.is_symlink(), 'SYMLINK_RECUSADO'
for rel in ('data/brain/system_knowledge/registry.json','data/brain/system_knowledge/history'):
 p=ROOT/rel
 assert not any(a.is_symlink() for a in [p,*p.parents]), 'SYMLINK_CONHECIMENTO_RECUSADO'
prepared=[]
for name,encoded in FILES.items():
 p=ROOT/name
 assert not any(a.is_symlink() for a in [p,*p.parents]), 'SYMLINK_RECUSADO'
 assert all(not a.exists() or a.is_dir() for a in p.parents), 'PASTA_INVALIDA: '+name
 assert p.is_file() or not BASELINES[name], 'BASE_AUSENTE: '+name
 body=base64.b64decode(encoded,validate=True)
 if p.is_file() and p.read_bytes()==body: continue
 if p.exists():
  assert p.is_file(), 'DESTINO_INVALIDO: '+name
  assert hashlib.sha256(p.read_bytes()).hexdigest() in BASELINES[name], 'BASE_DIVERGENTE_PRESERVADA: '+name+' SHA256='+hashlib.sha256(p.read_bytes()).hexdigest()
 if name.endswith('.py'):compile(body,str(p),'exec')
 prepared.append((name,p,body))
backup=ROOT/('.a24_capital_knowledge_v144_'+datetime.datetime.now().strftime('%Y%m%d_%H%M%S_%f'))
if prepared:
 backup.mkdir(mode=0o700)
 for name,p,body in prepared:
  if p.exists():
   dest=backup/name;dest.parent.mkdir(parents=True,exist_ok=True);shutil.copy2(p,dest)
 for name,p,body in prepared:
  p.parent.mkdir(parents=True,exist_ok=True)
  fd,tmp=tempfile.mkstemp(prefix='.recovery-',dir=p.parent)
  try:
   with os.fdopen(fd,'wb') as f: f.write(body)
   os.chmod(tmp,0o644);os.replace(tmp,p)
  finally:
   if os.path.exists(tmp):os.unlink(tmp)
 print('BACKUP='+str(backup))
for name,encoded in FILES.items():
 expected=base64.b64decode(encoded,validate=True)
 assert (ROOT/name).read_bytes()==expected
 print('VERIFICADO '+name+' '+hashlib.sha256(expected).hexdigest())
for rel in ('static/data/asset_registry_v365.json','static/data/portfolio_br_v365.json'):
 print(('DADO_EXISTENTE=' if (ROOT/rel).is_file() else 'DEPENDENCIA_DADOS_AUSENTE=')+rel)
import sys
sys.path.insert(0,str(ROOT))
from brain.knowledge.system_registry import SystemKnowledgeRegistry
registry=SystemKnowledgeRegistry(ROOT)
if not registry.verify()['current']:registry.refresh()
state=registry.verify()
assert state['current'], 'CONHECIMENTO_AINDA_DIVERGENTE'
print('CONHECIMENTO_DESCRITIVO_ATUALIZADO; DIVERGENCIAS='+str(state['stale_count'])+'; SEM_VALIDACAO_FINANCEIRA')
print('PATCH_PROTECAO_CONHECIMENTO_V144_OK; SERVICOS_NAO_INICIADOS; ALERTAS_SEM_VENDA_FORCADA; LIMITES_PRESERVADOS; REPARO_DESCRITIVO_NO_PATCH_CENTER; DADOS_FINANCEIROS_E_MODELOS_NAO_ALTERADOS')
PYTHON
if [[ "${1:-}" == "--reiniciar" ]]; then
  "$HOME/anaconda3/bin/python" -I -B "/Applications/Bridge_Companion/porquinho_v33_web_foundation-2/tools/restart_porquinho_checked_a24.py"
fi
