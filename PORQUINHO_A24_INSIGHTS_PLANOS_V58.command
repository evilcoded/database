#!/bin/bash
set -euo pipefail
umask 077
"$HOME/anaconda3/bin/python" -I -B - <<'PYTHON'
from pathlib import Path
import base64,hashlib,datetime,shutil,os,tempfile
ROOT=Path('/Applications/Bridge_Companion/porquinho_v33_web_foundation-2')
FILES={'static/experience_panels_v37.js': ''}
BASELINES={'static/experience_panels_v37.js': ('fc4e6ab6f73d3773f968f77eee9e3cbbc6a57ddc9c7c21641eeda58fc337dd12',)}
assert (ROOT/'webapp/server.py').is_file(), 'PROJETO_NAO_ENCONTRADO'
assert not ROOT.is_symlink(), 'SYMLINK_RECUSADO'
prepared=[]
for name,encoded in FILES.items():
 p=ROOT/name
 assert not any(a.is_symlink() for a in [p,*p.parents]), 'SYMLINK_RECUSADO'
 assert all(not a.exists() or a.is_dir() for a in p.parents), 'PASTA_INVALIDA: '+name
 body=base64.b64decode(encoded,validate=True)
 if p.is_file() and p.read_bytes()==body: continue
 if p.exists():
  assert p.is_file(), 'DESTINO_INVALIDO: '+name
  assert hashlib.sha256(p.read_bytes()).hexdigest() in BASELINES[name], 'BASE_DIVERGENTE_PRESERVADA: '+name+' SHA256='+hashlib.sha256(p.read_bytes()).hexdigest()
 if name.endswith('.py'):compile(body,str(p),'exec')
 prepared.append((name,p,body))
backup=ROOT/('.a24_insights_scope_v58_'+datetime.datetime.now().strftime('%Y%m%d_%H%M%S_%f'))
if prepared:
 backup.mkdir(mode=0o700)
 for name,p,body in prepared:
  if p.exists():
   dest=backup/name;dest.parent.mkdir(parents=True,exist_ok=True);shutil.copy2(p,dest)
 for name,p,body in prepared:
  p.parent.mkdir(parents=True,exist_ok=True)
  fd,tmp=tempfile.mkstemp(prefix='.recovery-',dir=p.parent)
  try:
   with os.fdopen(fd,'wb') as f: f.write(body)
   os.chmod(tmp,0o644);os.replace(tmp,p)
  finally:
   if os.path.exists(tmp):os.unlink(tmp)
 print('BACKUP='+str(backup))
for name,encoded in FILES.items():
 expected=base64.b64decode(encoded,validate=True)
 assert (ROOT/name).read_bytes()==expected
 print('VERIFICADO '+name+' '+hashlib.sha256(expected).hexdigest())
for rel in ('static/data/asset_registry_v365.json','static/data/portfolio_br_v365.json'):
 print(('DADO_EXISTENTE=' if (ROOT/rel).is_file() else 'DEPENDENCIA_DADOS_AUSENTE=')+rel)
print('PATCH_INSIGHTS_ESCOPO_V58_OK; SERVICOS_NAO_INICIADOS; DADOS_E_MODELOS_NAO_ALTERADOS')
PYTHON

# Read existing planning and funding diagnostics; write only the requested Downloads archive.
"$HOME/anaconda3/bin/python" -I -B - <<'DIAGNOSTIC'
from pathlib import Path
from datetime import datetime
import json,zipfile,urllib.request,urllib.error,hashlib
root=Path('/Applications/Bridge_Companion/porquinho_v33_web_foundation-2')
out={'collected_at':datetime.now().astimezone().isoformat(),'files':{}}
for name in ('data/investment_plans.json','data/planning_budgets.json','data/investment_plan_weekly_targets.json','static/data/portfolio_br_v365.json'):
 try:
  raw=(root/name).read_bytes();value=json.loads(raw)
  if name.startswith('static/'):
   value={'positions':[p for p in value.get('positions',[]) if p.get('asset_class')=='FIXED_INCOME']}
  out['files'][name]={'sha256':hashlib.sha256(raw).hexdigest(),'content':value}
 except Exception as exc:out['files'][name]={'error_type':type(exc).__name__}
try:
 with urllib.request.urlopen('http://127.0.0.1:8765/api/research/funding-contexts',timeout=120) as response:funding=json.load(response)
 out['funding']={k:v for k,v in funding.items() if k!='research_requests'}
 requests=funding.get('research_requests',[])
 from collections import Counter
 out['request_counts_by_currency']={q:dict(Counter(r.get('status') for r in requests if r.get('quote_currency')==q)) for q in {r.get('quote_currency') for r in requests}}
except Exception as exc:out['funding']={'error_type':type(exc).__name__,'http_code':getattr(exc,'code',None)}
folder=Path.home()/'Downloads';folder.mkdir(exist_ok=True)
archive=folder/('PORQUINHO_PLANOS_CAIXA_'+datetime.now().strftime('%Y%m%d_%H%M%S')+'.zip')
with zipfile.ZipFile(archive,'w',compression=zipfile.ZIP_DEFLATED) as z:z.writestr('planejamento.json',json.dumps(out,ensure_ascii=False,indent=2))
print('ENVIAR='+str(archive))
DIAGNOSTIC
