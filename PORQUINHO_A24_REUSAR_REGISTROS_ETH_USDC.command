#!/bin/bash
# Read existing records only. No installer, project writes or service activation.
set -euo pipefail
umask 077
ROOT="${PORQUINHO_ROOT:-$HOME/Desktop/Bridge_Companion/porquinho_v33_web_foundation-2}"
PYTHON_BIN="python3"
if [ -x "$ROOT/.venv/bin/python" ]; then PYTHON_BIN="$ROOT/.venv/bin/python"; fi
"$PYTHON_BIN" -I -B - "$ROOT" <<'A24_REUSE_PY'
import base64,datetime,hashlib,json,os,subprocess,sys
from pathlib import Path
root=Path(sys.argv[1]).resolve(strict=True)
EXPECTED={'universal_portfolio/ledger.py': 'c217b5b7021f68ff86115fc4637c2d1981a4cdba0bed50dad2870b1912ce9727', 'universal_portfolio/ledger_financial_translation.py': '5a4628a87b85d472b2281f5cce544470c275209291ee78695cbf4b338472a3e5', 'universal_portfolio/explicit_market_bindings_a24.py': '79a9e124fb6528325d47e05c50bd08849a8836d4d0f113df15049b92846145f7', 'universal_portfolio/manual_external_trade_durable_store.py': '73581dfc80bd7a9ee0cbccaa0e9c560c0bfaaf5f90a86d729b44f1b4af29505b'}
PAYLOAD=''
PAYLOAD_SHA='c41562f2313fa1d05c53e96ccb133032a685118d1691c88711e193e77651a1b2'
for rel,expected in EXPECTED.items():
 if hashlib.sha256((root/rel).read_bytes()).hexdigest()!=expected:raise SystemExit('SOURCE_BASELINE_DIFFERS; nenhum arquivo do projeto foi alterado.')
code=base64.b64decode(PAYLOAD)
if hashlib.sha256(code).hexdigest()!=PAYLOAD_SHA:raise SystemExit('READ_ONLY_CODE_INTEGRITY_FAILED')
result=subprocess.run([sys.executable,'-I','-B','-c',code.decode(),str(root)],cwd=root,capture_output=True,text=True,timeout=120)
if result.returncode:raise SystemExit('INSPECTION_SUBPROCESS_FAILED; nenhum relatório parcial será usado.')
try:report=json.loads(result.stdout)
except Exception:raise SystemExit('INSPECTION_REPORT_INVALID')
print(json.dumps(report,ensure_ascii=False,indent=2),flush=True)
folder=Path(os.environ.get('PORQUINHO_REPORT_DIRECTORY',str(Path.home()/'Downloads'))).expanduser().resolve(strict=True)
if folder.is_relative_to(root):raise SystemExit('REPORT_MUST_BE_OUTSIDE_PROJECT')
path=folder/('PORQUINHO_A24_REUSO_ETH_USDC_'+datetime.datetime.now().strftime('%Y%m%d_%H%M%S_%f')+'.json')
fd=os.open(path,os.O_CREAT|os.O_EXCL|os.O_WRONLY,0o600)
with os.fdopen(fd,'w') as stream:json.dump(report,stream,ensure_ascii=False,indent=2);stream.write('\n')
print('RELATORIO_PARA_COMPARTILHAR='+str(path))
print('Leitura de registros existentes; nenhum recadastramento, operação financeira, treino ou reinício. Valores e quantidades não foram exportados.')

A24_REUSE_PY
