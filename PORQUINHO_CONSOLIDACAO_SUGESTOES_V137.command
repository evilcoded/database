#!/bin/bash
set -euo pipefail
umask 077
"$HOME/anaconda3/bin/python" -I -B - <<'PYTHON'
from pathlib import Path
import base64,hashlib,datetime,shutil,os,tempfile
ROOT=Path('/Applications/Bridge_Companion/porquinho_v33_web_foundation-2')
FILES={'universal_portfolio/operational_decision_core_a24.py': '', 'universal_portfolio/global_operational_plan_a24.py': '', 'universal_portfolio/operational_outcome_tracking_a24.py': '', 'universal_portfolio/operational_cycle_a24.py': '', 'tools/diagnose_decision_pipeline_a24.py': '', 'porquinho.py': '', 'universal_portfolio/global_action_readings_a24.py': '', 'universal_portfolio/universal_observation_bridge.py': '', 'universal_portfolio/experience_panels_a24.py': '', 'universal_portfolio/monitor_consolidation_a24.py': '', 'static/experience_panels_v37.js': '', 'static/dashboard_universal_v35.js': '', 'webapp/server.py': '', 'templates/index.html': ''}
BASELINES={'universal_portfolio/operational_decision_core_a24.py': [], 'universal_portfolio/global_operational_plan_a24.py': [], 'universal_portfolio/operational_outcome_tracking_a24.py': [], 'universal_portfolio/operational_cycle_a24.py': [], 'tools/diagnose_decision_pipeline_a24.py': [], 'porquinho.py': ['fe9405c335306ee295f0f72b477ce4c5ab935e8b33f5e9ee1d6cb9657de11f50'], 'universal_portfolio/global_action_readings_a24.py': ['1e28e52a2dbc72054b6ef08107bcf2fc8dddedbe0e4671233e653a2c861ae06c'], 'universal_portfolio/universal_observation_bridge.py': ['eec746a8cc3f96747d4c28913c6e4f5d9288df931325b519487ce2a3dab9fbfb'], 'universal_portfolio/experience_panels_a24.py': ['92a76269f8107253b85d9276d36453447498c4734ecbc8929bc15277fbc0d097'], 'universal_portfolio/monitor_consolidation_a24.py': ['b0b5a69e6cc64fca277edae4bafc495e4aefe051a6071e7afee9955033748a2e'], 'static/experience_panels_v37.js': ['d0f187601eda6bfe68d6e3915cbce97b211bc6ce5310baf696bc97a33b78f689'], 'static/dashboard_universal_v35.js': ['3e1ea9d0ad1f3fe86d60304748de3a89f93e5594faaf43a2b134f087bb5d05d4'], 'webapp/server.py': ['12669a03cc30f81a78afa69da8c54cc132297a4b1405b57eebbb286c763fd6d4'], 'templates/index.html': ['4a4da70cefe781ff39313c5218a1d95307b20074be10a33864e4d956c9e2dddd']}
assert (ROOT/'webapp/server.py').is_file(), 'PROJETO_NAO_ENCONTRADO'
assert not ROOT.is_symlink(), 'SYMLINK_RECUSADO'
prepared=[]
for name,encoded in FILES.items():
 p=ROOT/name
 assert not any(a.is_symlink() for a in [p,*p.parents]), 'SYMLINK_RECUSADO'
 assert all(not a.exists() or a.is_dir() for a in p.parents), 'PASTA_INVALIDA: '+name
 assert p.is_file() or not BASELINES[name], 'BASE_AUSENTE: '+name
 body=base64.b64decode(encoded,validate=True)
 if p.is_file() and p.read_bytes()==body: continue
 if p.exists():
  assert p.is_file(), 'DESTINO_INVALIDO: '+name
  assert hashlib.sha256(p.read_bytes()).hexdigest() in BASELINES[name], 'BASE_DIVERGENTE_PRESERVADA: '+name+' SHA256='+hashlib.sha256(p.read_bytes()).hexdigest()
 if name.endswith('.py'):compile(body,str(p),'exec')
 prepared.append((name,p,body))
backup=ROOT/('.a24_global_operational_plan_v137_'+datetime.datetime.now().strftime('%Y%m%d_%H%M%S_%f'))
if prepared:
 backup.mkdir(mode=0o700)
 for name,p,body in prepared:
  if p.exists():
   dest=backup/name;dest.parent.mkdir(parents=True,exist_ok=True);shutil.copy2(p,dest)
 for name,p,body in prepared:
  p.parent.mkdir(parents=True,exist_ok=True)
  fd,tmp=tempfile.mkstemp(prefix='.recovery-',dir=p.parent)
  try:
   with os.fdopen(fd,'wb') as f: f.write(body)
   os.chmod(tmp,0o644);os.replace(tmp,p)
  finally:
   if os.path.exists(tmp):os.unlink(tmp)
 print('BACKUP='+str(backup))
for name,encoded in FILES.items():
 expected=base64.b64decode(encoded,validate=True)
 assert (ROOT/name).read_bytes()==expected
 print('VERIFICADO '+name+' '+hashlib.sha256(expected).hexdigest())
for rel in ('static/data/asset_registry_v365.json','static/data/portfolio_br_v365.json'):
 print(('DADO_EXISTENTE=' if (ROOT/rel).is_file() else 'DEPENDENCIA_DADOS_AUSENTE=')+rel)
print('PATCH_CONSOLIDACAO_SUGESTOES_V137_OK; SERVICOS_NAO_INICIADOS; MOTOR_ORIGINAL_COMPARTILHADO; PLANO_OPERACIONAL_GLOBAL; ACOMPANHAMENTO_30_60_90_120; DADOS_FINANCEIROS_E_MODELOS_NAO_ALTERADOS')
PYTHON
if [[ "${1:-}" == "--reiniciar" ]]; then
  "$HOME/anaconda3/bin/python" -I -B "/Applications/Bridge_Companion/porquinho_v33_web_foundation-2/tools/restart_porquinho_checked_a24.py"
fi
